{
  "manifest_version": "0.4",
  "name": "badhusha-whatsapp-mcp",
  "display_name": "Badhusha WhatsApp MCP",
  "version": "0.4.0",
  "description": "Personal WhatsApp MCP for ChatGPT, Grok, Claude and MCP-compatible clients.",
  "author": {
    "name": "Badhusha K",
    "url": "https://github.com/wazimBadsha"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wazimBadsha/whatsapp-mcp-plugin.git"
  },
  "homepage": "https://github.com/wazimBadsha/whatsapp-mcp-plugin",
  "documentation": "https://github.com/wazimBadsha/whatsapp-mcp-plugin#readme",
  "support": "https://github.com/wazimBadsha/whatsapp-mcp-plugin/issues",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "fastmcp",
    "whatsapp"
  ],
  "server": {
    "type": "python",
    "entry_point": "whatsapp-mcp-server/main.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "--directory",
        "${__dirname}/whatsapp-mcp-server",
        "run",
        "main.py"
      ],
      "env": {}
    }
  },
  "tools_generated": true,
  "compatibility": {
    "claude_desktop": ">=0.10.0",
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ]
  }
}
